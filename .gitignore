# Obsidian: keep the shareable settings (app, appearance, graph colors, core and community plugin lists)
# Per-device window layout and recent files; changes on every click
.obsidian/workspace.json
.obsidian/workspace-mobile.json
# Installed plugins: third-party code reinstalled from the store; plugin data can hold secrets (MCP Connector's bearer token is in its data.json)
.obsidian/plugins/

# Obsidian's local trash
.trash/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Claude Code personal settings and Python caches
.claude/settings.local.json
__pycache__/

# Personal layer: lives in the vault, never in the public repo (the PREFRONTAL guide stays: it is generic)
PREFRONTAL/*
!PREFRONTAL/PREFRONTAL.md
.remember/

# Shared knowledge notes and project hubs: shared through the brain, never in the public repo (only their guides are)
NEOCORTEX/KNOWLEDGE/*
!NEOCORTEX/KNOWLEDGE/KNOWLEDGE.md
NEOCORTEX/PROJECTS/*
!NEOCORTEX/PROJECTS/PROJECTS.md

# In-transit proposals and their trail: only the HIPPOCAMPUS guide is shared
HIPPOCAMPUS/*
!HIPPOCAMPUS/HIPPOCAMPUS.md
